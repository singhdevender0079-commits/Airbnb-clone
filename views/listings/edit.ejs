<% layout("/layouts/boilerplate") %>
<body>
    <br>
    
  <div class="row">
    
    <div class="col-12 ">
    <h3>Edit the listing</h3>
    <br>
    <form method="post" action="/listing/<%=listing._id%>?_method=put">

        <div class="mb-3">  
               <label for="title" class="form-lable">Add a catchy title</label>
             
 <input type="text" name="title" id="" placeholder="Enter the title" value="<%= listing.title %>" class="form-control">
</div>

<div class="mb-3">
<label for="description" class="form-lable" >Description</label>
<textarea name="description" id="" class="form-control"><%= listing.description %></textarea>
</div>

<div class="mb-3">
  <label for="image" class="form-lable" >Image</label>
<input type="text" name="image" id="" class="form-control" placeholder="enter img Url/link" value="<%= listing.image %>">
</div>

<div class="row">
<div class="mb-3 col-md-4" >
<label for="price" class="form-lable">Price</label>
<input type="number" id="" name="price" placeholder="Enter the price" value="<%= listing.price %>" class="form-control">
</div>

<div class="mb-3 col-md-8">
  <label for="country" class="form-lable">Country</label>
<input type="text" name="country" id="" placeholder="Enter the country" value="<%= listing.country%>" class="form-control">
</div>
</div>

<div class="mb-3">
  <label for="location" class="form-lable">location</label>
<input type="text" name="location" id="" placeholder="Enter the location" value="<%= listing.location %>" class="form-control">
</div>





<br>

<button class="btn add-btn">Submit</button>
    </form>
    </div>
    </div>
</body>
</html>