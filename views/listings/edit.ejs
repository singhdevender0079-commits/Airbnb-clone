<% layout("/layouts/boilerplate") %>
<body>
    <br>
    
  <div class="row">
  
    <div class="col-12 ">
    <h3>Edit the listing</h3>
    <br>
    <form method="post" action="/listings/<%=listing._id%>?_method=put" novalidate class="needs-validation">

        <div class="mb-3">  
               <label for="title" class="form-lable">Add a catchy title</label>
             
 <input type="text" name="listing[title]"id="" placeholder="Enter the title" value="<%= listing.title %>" class="form-control" required>
  <div class="valid-feedback">
    title looks good!
    </div>
</div>

<div class="mb-3">
<label for="description" class="form-lable" >Description</label>
<textarea name="listing[description]" id="" class="form-control" required><%= listing.description %></textarea>
<div class="invalid-feedback">
  enter a short description
    </div>
</div>

<div class="mb-3">
  <label for="image" class="form-lable" >Image</label>
<input type="text"name="listing[image]" id="" class="form-control" placeholder="enter img Url/link" value="<%= listing.image %>" required>
 <div class="invalid-feedback">
  enter a valid link
    </div>
</div>

<div class="row">
<div class="mb-3 col-md-4" >
<label for="price" class="form-lable">Price</label>
<input type="number" id="" name="listing[price]" placeholder="Enter the price" value="<%= listing.price %>" class="form-control" required>
 <div class="invalid-feedback">
  enter a valid price
    </div>
</div>

<div class="mb-3 col-md-8">
  <label for="country" class="form-lable">Country</label>
<input type="text"name="listing[country]" id="" placeholder="Enter the country" value="<%= listing.country%>" class="form-control" required>
 <div class="invalid-feedback">
  enter a valid country
    </div>
</div>
</div>
<div class="mb-3">
  <label for="location" class="form-lable">location</label>
<input type="text" name="listing[location]" id="" placeholder="Enter the location" value="<%= listing.location %>" class="form-control" required>
 <div class="invalid-feedback">
  enter a valid location
    </div>
</div>





<br>

<button class="btn add-btn">Submit</button>
    </form>
    </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>