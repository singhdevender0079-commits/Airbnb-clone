<% layout("/layouts/boilerplate") %>
<body>
    <br>
    <h3 class="offset-2">details :</h3>

<div class="row">

<div class="card col-6 offset-3">
  <img src="<%= listing.image %>" class="card-img-top img-show" alt="list_img">
  <div class="card-body">
    <p class="card-text"><%= listing.title %><br>
        <br>
        <%= listing.description %>
        <br>
₹  <%= listing.price.toLocaleString("en-IN")%><br>
<%= listing.location %>
<br>
<%= listing.country %>
    </p>
  </div>
</div>

</div>
<div class="btns offset-3">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
    <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn " style="background-color: red;">Delete</button>
    </form>
  </div>
</body>
</html>